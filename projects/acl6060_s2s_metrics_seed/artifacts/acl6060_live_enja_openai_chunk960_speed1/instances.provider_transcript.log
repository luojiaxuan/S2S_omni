6.944, 556946.944, 557080.051, 557080.505, 557092.549, 557785.603, 557801.484, 557801.484, 557868.145, 557895.474, 557950.639, 557972.588, 557972.588, 559081.787, 559126.581, 559126.581, 559199.559, 559253.679, 560239.459, 560240.122, 560300.929, 560331.273, 560331.273, 560374.842, 560387.966, 561070.309, 561089.343, 561089.343, 561163.636, 561192.134, 561229.486, 561229.486, 561229.486, 561229.486, 561229.486, 561893.028, 566924.487, 567864.628, 567936.382, 567936.382, 567971.468, 568036.188, 568036.721, 568068.337, 569142.502, 569219.718, 569220.177, 569315.865, 569316.049, 570322.63, 570322.63, 570494.91, 570495.256, 570495.406, 570515.806, 570516.887, 570678.064, 570696.117, 570696.117, 570737.627, 570780.529, 570825.227, 570831.724, 570874.369, 571531.039, 571588.243, 571652.174, 571683.469, 571734.969, 571735.18, 572633.71, 572634.047, 572742.041, 572742.041, 572742.041, 572759.357, 572772.197, 572772.197, 574014.572, 574068.642, 574075.503, 574140.546, 574181.787, 576416.368, 576425.063, 576425.063, 576586.444, 576586.444, 576586.444, 576586.626, 576586.626, 576586.626, 576586.626, 576903.212, 578205.62, 578205.62, 578245.392, 578304.336, 578304.336, 579109.912, 579109.912, 579167.724, 579318.031, 579318.313, 579804.664, 579865.306, 579865.306, 579955.024, 579957.543, 580002.137, 580652.442, 580652.442, 580652.442, 580773.026, 582679.573, 582679.573, 583639.777, 583713.519, 583828.524, 583828.919, 583829.117, 584553.62, 584602.894, 584739.019, 584739.254, 584739.254, 585005.918, 585005.918, 585005.918, 585005.918, 585483.6, 585483.825, 585483.825, 585483.825, 585546.791, 585546.791, 585546.791, 586555.074, 586612.073, 586612.073, 586612.073, 586742.885, 586743.101, 586743.272, 586757.221, 587647.994, 587647.994, 587647.994, 587647.994, 587783.299], "prediction_length": 2833, "reference": "こんにちは。Michał Pietruszkaと申します。『訓練可能な表現プーリングによるトランスフォーマーモデルの分散』と題した論文をご紹介します。 これは、Lukasz BorchmannとLukasz Garncarekとの協力で、Applica AIで行われた研究です。 まずは、私たちの研究の目標についてお話しします。 私たちの方法は、