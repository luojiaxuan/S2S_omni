+                _tab.append(f"m={_m}:{_h}")
+                _bad += (_h == 1)
+            logger.info(f"phrase hold budget per multiplier: {' '.join(_tab)}")
+            logger.info(f"phrase degenerate (max_hold_steps==1, 永不 hold): {_bad}/{len(_tab)} multipliers")
 
